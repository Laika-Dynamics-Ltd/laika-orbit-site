# Laika Orbit site: sales configuration. Copy to .env (gitignored) for local runs; set the same
# names in the Vercel project for deploys. Test mode is enforced unless STRIPE_ALLOW_LIVE=1.

SALES_OPEN=                   # 1 to take payments; empty = Pro buttons join the waitlist
STRIPE_SECRET_KEY=            # sk_test_… (Stripe Dashboard → Developers → API keys, test mode)
STRIPE_WEBHOOK_SECRET=        # whsec_… (the webhook endpoint's signing secret, or `stripe listen --print-secret` locally)
STRIPE_PRICE_PRO_MONTHLY=     # price_… lookup key orbit_pro_monthly
STRIPE_PRICE_PRO_YEARLY=      # price_… lookup key orbit_pro_yearly
STRIPE_AUTOMATIC_TAX=         # 1 once Stripe Tax is set up (origin address + registrations)
LICENSE_SIGNING_KEY=          # base64 of the Ed25519 private key PEM (pnpm license:keygen <dir>)
RESEND_API_KEY=               # waitlist storage (optional)
RESEND_AUDIENCE_ID=
STRIPE_ALLOW_LIVE=            # 1 only with Joe's go-ahead, together with an sk_live_ key
