---
import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
import KnowledgeMap from '../../components/KnowledgeMap.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Lab · Knowledge map</title>
    <style is:global>
      html,
      body {
        margin: 0;
        background: #08090a;
        color: #dfe4f0;
        font-family: 'Inter Variable', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      main {
        box-sizing: border-box;
        max-width: 1232px;
        margin: 0 auto;
        padding: 48px 16px;
      }
    </style>
  </head>
  <body>
    <main>
      <KnowledgeMap />
    </main>
  </body>
</html>
