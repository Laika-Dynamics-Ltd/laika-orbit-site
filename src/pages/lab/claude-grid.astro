---
import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
import '../../styles/site.css'
import ClaudeGrid from '../../components/ClaudeGrid.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Claude grid</title>
  </head>
  <body>
    <main class="lab">
      <div class="lab-frame"><ClaudeGrid /></div>
    </main>
  </body>
</html>

<style>
  body {
    background: #08090a;
  }
  .lab {
    width: min(1200px, 100% - 32px);
    margin: 64px auto;
  }
  .lab-frame {
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 14px;
    overflow: hidden;
  }
</style>
