---
/**
 * The recall docs moved from /docs/1brain/… to /docs/recall/…. The 301s in astro.config.mjs only
 * match the slashless form, and every link the site published ended in a slash, so these small
 * pages sit at the old paths and send visitors on. Prerendered, so the filesystem serves them
 * whichever way the URL is written.
 */
export const prerender = true

export function getStaticPaths() {
  return ['', 'mcp', 'cli', 'routers', 'how-recall-works', 'configuration'].map((rest) => ({
    params: { rest: rest || undefined },
  }))
}

const rest = Astro.params.rest ?? ''
const to = `/docs/recall/${rest ? `${rest}/` : ''}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to {to}</title>
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to)</script>
  </head>
  <body style="background:#08090a;color:#b4b8c1;font:16px/1.6 system-ui;padding:40px">
    <p>These docs moved to <a href={to} style="color:#ff7a45">{to}</a>.</p>
  </body>
</html>
