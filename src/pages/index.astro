---
import { Image } from 'astro:assets'
import away from '../assets/product/cockpit/away.webp'
import fleet from '../assets/product/cockpit/fleet.webp'
import panels from '../assets/product/cockpit/panels.webp'
import queue from '../assets/product/cockpit/queue.webp'
import runs from '../assets/product/cockpit/runs.webp'
import recall from '../assets/product/recall.webp'
import HeroWorkspace from '../components/HeroWorkspace.astro'
import KnowledgeMap from '../components/KnowledgeMap.astro'
import Download from '../components/Download.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import Site from '../layouts/Site.astro'
import { RELEASE, ready as downloadReady } from '../lib/release.mjs'

const GITHUB = 'https://github.com/Laika-Dynamics-Ltd/laika-orbit'

const compare: { row: string; editors: string; apps: string; orbit: string }[] = [
  { row: 'Several agents running side by side', editors: 'yes', apps: 'yes', orbit: 'yes' },
  { row: 'A browser with a profile per account, and extensions', editors: 'partial', apps: 'partial', orbit: 'yes' },
  { row: 'Inbox and calendar in the same window', editors: 'no', apps: 'no', orbit: 'yes' },
  { row: 'A map of your files, repos and chats', editors: 'partial', apps: 'partial', orbit: 'yes' },
  { row: 'Retrieval with zero model calls', editors: 'no', apps: 'no', orbit: 'yes' },
  { row: 'Several Claude accounts at once, with usage', editors: 'partial', apps: 'no', orbit: 'yes' },
  { row: 'Runs on your machines, not a vendor cloud', editors: 'partial', apps: 'partial', orbit: 'yes' },
  { row: 'Open source', editors: 'partial', apps: 'no', orbit: 'yes' },
]
const mark = { yes: '●', partial: '◐', no: '—' } as const
---

<Site
  title="Laika Orbit — mission control for your AI agents"
  description="Run many Claude Code agents at once. Laika Orbit keeps them moving, shows what needs you first, and keeps working while you are away. On your own Mac. Open source."
>
  <Nav />

  <main>
    <!-- ───────────────────────────────── hero ── -->
    <section class="hero">
      <canvas class="orbit" aria-hidden="true"></canvas>
      <div class="orbit-poster" aria-hidden="true"></div>
      <div class="wrap hero-in">
        <a class="pill" href="/docs/recall/mcp/">
          <span class="pill-tag">New</span>
          <span>Laika Orbit recall for Claude Code<span class="pill-more">: answers with zero model calls</span></span>
          <span aria-hidden="true">→</span>
        </a>
        <h1>Mission control<br />for your AI agents</h1>
        <p class="lede">
          Run a fleet of Claude Code agents side by side. Orbit keeps them moving, puts what needs you
          first, and keeps working while you are away. One window, on your own Mac.<span class="lede-tail"> Open source.</span>
        </p>
        {downloadReady ? (
          <Download secondary={{ href: GITHUB, label: 'Star on GitHub' }} />
        ) : (
          <div class="hero-cta">
            <a class="btn btn-light" href="/docs/getting-started/">Get started for free</a>
            <a class="btn btn-ghost" href={GITHUB}>Star on GitHub</a>
          </div>
        )}
        <p class="hero-note">
          {downloadReady && <><a href="/docs/getting-started/">Or install from source</a> · </>}
          Already in Claude Code? Add Laika Orbit recall with
          <code class="cmd"><span class="dim">$</span> npx laikaorbit mcp</code>
        </p>
      </div>

      <div class="wrap wrap-wide">
        <div class="hero-frame"><HeroWorkspace /></div>
      </div>
    </section>

    <!-- ─────────────────────────────── proof strip ── -->
    <section class="strip wrap" aria-label="At a glance">
      <span>Runs Claude Code</span><span>MCP native</span><span>macOS</span><span>MIT licensed</span><span>Local-first</span><span>No telemetry by default</span>
    </section>

    <!-- ─────────────────────────────── the problem ── -->
    <section class="section wrap problem">
      <div class="eyebrow">The problem</div>
      <h2>Your editor runs an agent.<br /><span class="muted">Your day runs on twelve windows.</span></h2>
      <div class="sprawl">
        <figure class="scene before" aria-label="Before: a dozen windows">
          <div class="desk">
            <div class="win w1"><div class="wb">Editor · agent panel</div></div>
            <div class="win w2"><div class="wb">zsh — claude</div><div class="lines"><i></i><i></i><i></i></div></div>
            <div class="win w3"><div class="wb">zsh — claude (2)</div><div class="lines"><i></i><i></i></div></div>
            <div class="win w4"><div class="wb">Chrome · Work</div></div>
            <div class="win w5"><div class="wb">Chrome · Client</div></div>
            <div class="win w6"><div class="wb">Mail</div></div>
            <div class="win w7"><div class="wb">Calendar</div></div>
            <div class="win w8"><div class="wb">notes.md</div></div>
            <div class="win w9"><div class="wb">Usage · Settings</div></div>
          </div>
          <figcaption><b>Today</b> An editor, six terminals, three browser profiles, mail, calendar and notes, and you as the glue.</figcaption>
        </figure>
        <figure class="scene after" aria-label="After: one Laika Orbit window">
          <div class="desk">
            <div class="orbitwin">
              <div class="wb">Laika Orbit</div>
              <div class="ow">
                <div class="rail"><i class="on"></i><i></i><i></i><i></i></div>
                <div class="chats"><div><b></b><i></i><i></i></div><div><b></b><i></i><i></i></div><div><b></b><i></i></div><div><b></b><i></i><i></i></div></div>
                <div class="side"><span>Needs you · 3</span><span>14:00 Design review</span><span>Work 62%</span></div>
              </div>
            </div>
          </div>
          <figcaption><b>With Orbit</b> Your agents, browser, inbox, calendar and knowledge in one window, in orbit around the work.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ─────────────────────────────── product ── -->
    <section class="section wrap product" id="product">
      <div class="split-head">
        <div>
          <div class="eyebrow">Product</div>
          <h2>A cockpit for a fleet of agents.</h2>
        </div>
        <p class="muted">
          Run many Claude Code chats at once. Orbit keeps them moving, puts what needs you first, and
          sits beside the editor you already use.
        </p>
      </div>

      <article class="pf">
        <div class="pf-copy">
          <h3>Give it a goal. It runs the fleet.</h3>
          <p>
            A conductor chat sends each of your chats its next step. Switch to Away and it keeps them
            going: the plainly safe steps are approved, stuck chats are brought back, and anything that
            reaches outside your Mac waits for you. Come back to one summary card.
          </p>
          <a class="link" href="/docs/away-mode/">How away mode works →</a>
        </div>
        <button class="pf-zoom" type="button"><figure class="pf-shot"><Image src={away} alt="The Autopilot panel set to Away, with the conductor leading and the chats working beside it" widths={[800, 1400, 2502]} sizes="(max-width: 960px) 100vw, 60vw" /></figure></button>
      </article>

      <article class="pf pf-flip">
        <div class="pf-copy">
          <h3>Every chat. What each one needs.</h3>
          <p>
            Chats run side by side, one per task, on any of your Claude accounts, and they come back after
            a restart. The fleet board puts the ones waiting on you at the top.
          </p>
          <p class="pf-note">
            <span>New</span> Each chat shows its branch, commits and uncommitted files. Mark its work
            ready and the merge train lands it on your local main once the repo's own check passes. If
            the check goes red, the chat that broke it gets the output. Pushing stays with you.
          </p>
        </div>
        <button class="pf-zoom" type="button"><figure class="pf-shot"><Image src={fleet} alt="The fleet board: three chats waiting on you at the top, the rest grouped below, next to the conductor and an open chat" widths={[800, 1400, 2636]} sizes="(max-width: 960px) 100vw, 60vw" /></figure></button>
      </article>

      <div class="pf-pair">
        <article class="pf-tall">
          <div class="pf-copy">
            <h3>Long jobs report themselves.</h3>
            <p>Builds, test runs and batch jobs share one page, with progress and an ETA. A job that goes quiet is flagged as stalled. Before and after sit side by side.</p>
          </div>
          <button class="pf-zoom" type="button"><figure class="pf-shot tall"><Image src={runs} alt="The runs panel: a backfill that went quiet flagged at the top, a gauntlet with two artefacts, an iOS build on another machine, two finished today" widths={[400, 750]} sizes="(max-width: 960px) 100vw, 30vw" /></figure></button>
        </article>
        <article class="pf-tall">
          <div class="pf-copy">
            <h3>Work that waits its turn.</h3>
            <p>Line up the next tasks. The queue survives restarts, and with autopilot on, the next item starts by itself when a chat frees up.</p>
          </div>
          <button class="pf-zoom" type="button"><figure class="pf-shot tall"><Image src={queue} alt="The queue: six tasks for three repos, one running, two waiting on others to finish first" widths={[400, 830]} sizes="(max-width: 960px) 100vw, 30vw" /></figure></button>
        </article>
      </div>

      <article class="pf">
        <div class="pf-copy">
          <h3>Heavy work goes to your other machines.</h3>
          <p>
            Test runs, builds and captures run on a Linux box under the desk, and the files come back
            when they finish. No vendor cloud. Windows PCs for GPU work are in testing.
          </p>
          <a class="link" href="/docs/other-machines/">Set up a machine →</a>
        </div>
        <div class="term pf-term" role="img" aria-label="Terminal: offload lists the machines and runs a command on one">
          <div class="term-bar"><i></i><i></i><i></i><span>zsh</span></div>
<pre><span class="dim">$</span> node packages/app/offload.mjs machines
<span class="hl">box1</span>   <span class="ok">online</span>   6 cores, load 5.5, mem 48%, 0 job(s)

<span class="dim">$</span> node packages/app/offload.mjs run --on box1 --bring back.txt \
    -- sh -c 'echo made-on-box1 &gt; back.txt'
<span class="dim">offload:</span> running sh on box1
<span class="dim">offload:</span> <span class="ok">done on box1 in 0s, exit 0</span>

<span class="dim">$</span> cat back.txt
made-on-box1</pre>
        </div>
      </article>

      <div class="pf-grid">
        <article class="pf-cell wide">
          <button class="pf-zoom" type="button"><figure class="pf-shot"><Image src={panels} alt="Panels docked in one window: apps, calendar and the cockpit beside two chats" widths={[800, 1600, 3060]} sizes="(max-width: 960px) 100vw, 66vw" /></figure></button>
          <h3>Panels, not windows</h3>
          <p>Fleet, runs, queue, calendar and your apps dock beside the chats, and the layout is yours.</p>
        </article>
        <article class="pf-cell">
          <button class="pf-zoom" type="button"><figure class="pf-shot"><Image src={recall} alt="Recall: an answer and the file it came from, in a palette" widths={[600, 1200]} sizes="(max-width: 960px) 100vw, 33vw" /></figure></button>
          <h3>Answers, not searches</h3>
          <p>Press ⌘K and recall finds the section that answers you in about a millisecond, with no model calls.</p>
        </article>
        <article class="pf-cell">
          <h3>A real browser, every login</h3>
          <p>Chromium tabs with a profile per account, signed in side by side. Chrome extensions included.</p>
        </article>
        <article class="pf-cell span2">
          <h3>Backs off when you look away</h3>
          <p>Hidden panels stop drawing. Idle, the app went from 41% of a CPU core to 11%, and to 5.5% while you're in another window.</p>
        </article>
      </div>
    </section>

    <!-- ─────────────────────────────── knowledge ── -->
    <section class="section wrap">
      <div class="eyebrow">Knowledge</div>
      <div class="split-head">
        <h2>Everything you know,<br />one keystroke away.</h2>
        <p class="muted">
          Files, repos, notes, chats and routines, drawn as a map you can fly through. Press
          <kbd>⌘</kbd><kbd>K</kbd> and the answer is there, with the file it came from.
        </p>
      </div>
      <div class="frame frame-bare"><KnowledgeMap /></div>
      <p class="recall-line" id="recall">
        Search runs on <a href="/docs/recall/">Laika Orbit recall</a>: the exact section in about a
        millisecond, with no model calls. It works in any Claude Code session today:
        <code>claude mcp add laikaorbit -- npx -y laikaorbit mcp</code>
      </p>
    </section>

    <!-- ─────────────────────────────── away ── -->
    <section class="section wrap away" id="away">
      <div class="away-copy">
        <div class="eyebrow">Away mode</div>
        <h2>Walk away.<br /><span class="muted">Come back to one card.</span></h2>
        <p class="muted">
          Say how long you'll be gone. Your chats keep moving: the plainly safe steps are approved for
          you, chats that stall or hit a usage limit are brought back, and everything else waits. When
          you're back, one card says what finished, what's still running and what needs you.
        </p>
        <ul class="away-rules">
          <li><b>Safe steps only.</b> Reading, editing and running tests inside each chat's own folder.</li>
          <li><b>Never on its own.</b> Pushing, deploying, deleting, the web, or another machine.</li>
          <li><b>Every decision logged</b>, and a budget you can set before you go.</li>
        </ul>
        <a class="link" href="/docs/away-mode/">How away mode works →</a>
      </div>
      <div class="away-card" role="img" aria-label="Example summary card: while you were away, six tasks finished, one chat is still running and two need you">
        <div class="term-bar"><i></i><i></i><i></i><span>Summary</span></div>
        <div class="sc">
          <div class="sc-head">While you were away · 13:05–15:45 · 2h 40m</div>
          <div class="sc-headline">6 tasks finished in 4 chats. 2 need you.</div>
          <div class="sc-sec">needs you · 2</div>
          <div class="sc-row need u-now"><i></i><span><b>api</b> Wants to run the database migration on staging</span><em>12m</em></div>
          <div class="sc-row need u-soon"><i></i><span><b>web</b> Asks which pricing headline to ship</span><em>40m</em></div>
          <div class="sc-sec">running · 1</div>
          <div class="sc-row run"><i></i><span><b>mobile</b> Rebuilding the iOS app on box1 · 25m in<span class="sc-bar"><i style="width:70%"></i></span></span><em class="eta">~15:55</em></div>
          <div class="sc-sec">finished · 6</div>
          <div class="sc-row done"><i></i><span><b>web</b> Checkout tests · Flaky login test fixed</span><em>2✓</em></div>
          <div class="sc-row done"><i></i><span><b>docs</b> Screenshots refreshed · Broken links fixed</span><em>2✓</em></div>
          <div class="sc-row done"><i></i><span><b>api</b> Rate limiter · Error messages</span><em>2✓</em></div>
          <div class="sc-sec">auto-approved 31 · recovered 1</div>
          <div class="sc-row auto"><i></i><span><b>web</b> Edit, pnpm test</span><em>18</em></div>
          <div class="sc-row rec"><i></i><span><b>mobile</b> Hit a usage limit, waited for the reset and carried on</span><em>14:20</em></div>
        </div>
      </div>
    </section>

    <!-- ─────────────────────────────── compare ── -->
    <section class="section wrap" id="compare">
      <div class="eyebrow">Compare</div>
      <div class="split-head">
        <h2>Not another editor.<br /><span class="muted">The cockpit around your agents.</span></h2>
        <p class="muted">
          AI editors and agent apps are great at one repo and one conversation. Orbit is built for
          everything around them. Use it alongside the editor you already love.
        </p>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <thead>
            <tr><th></th><th>AI code editors<small>VS Code, Cursor</small></th><th>Agent apps<small>Claude Code desktop, Codex</small></th><th class="us">Laika Orbit</th></tr>
          </thead>
          <tbody>
            {compare.map((c) => (
              <tr>
                <td>{c.row}</td>
                <td class={c.editors}>{mark[c.editors as keyof typeof mark]}</td>
                <td class={c.apps}>{mark[c.apps as keyof typeof mark]}</td>
                <td class={`us ${c.orbit}`}>{mark[c.orbit as keyof typeof mark]}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="footnote">● yes · ◐ partly · — no. From each product's public docs, September 2026. Laika Orbit runs Claude Code and is not affiliated with Anthropic.</p>
      </div>
    </section>

    <!-- ─────────────────────────────── built with orbit ── -->
    <section class="section wrap proof" aria-label="Built with Orbit">
      <div class="eyebrow">Built with Orbit</div>
      <dl class="stats proof-stats">
        <div><dt>27</dt><dd>Claude Code chats run in Orbit in one day</dd></div>
        <div><dt>17</dt><dd>chats working in the same hour</dd></div>
        <div><dt>1</dt><dd>person steering, approving every push and deploy</dd></div>
      </dl>
      <a class="link bw-more" href="/built-with-orbit/">How Orbit builds Orbit →</a>
    </section>

    <!-- ─────────────────────────────── open source ── -->
    <section class="section wrap oss">
      <div class="oss-card">
        <div>
          <div class="eyebrow">Open source</div>
          <h2>Yours to read, run and change.</h2>
          <p class="muted">MIT licensed. Local-first: the server listens only on your machine, and nothing is sent to us. Bring your own Claude account.</p>
        </div>
        <div class="oss-actions">
          <a class="btn btn-light" href={GITHUB}>View on GitHub</a>
          <a class="btn btn-ghost" href="/docs/reference/security/">Privacy and security</a>
        </div>
      </div>
    </section>

    <!-- ─────────────────────────────── final CTA ── -->
    <section class="final wrap">
      <h2>Ready for liftoff?</h2>
      <p class="muted">Download it, give it a goal, and let the fleet run.</p>
      {downloadReady ? (
        <div class="hero-cta center">
          <a class="btn btn-light" href={RELEASE.url} data-download={RELEASE.file}>Download for Mac</a>
          <a class="btn btn-ghost" href="/docs/">Read the docs</a>
        </div>
      ) : (
        <div class="hero-cta center">
          <a class="btn btn-light" href="/docs/getting-started/">Get started for free</a>
          <a class="btn btn-ghost" href="/docs/">Read the docs</a>
        </div>
      )}
    </section>
  </main>

  <Footer />

  <!-- The screenshot lightbox: one dialog for every .pf-shot, filled on click with the largest
       candidate of the image's own srcset, so no asset is added for it. -->
  <dialog class="lb" aria-label="Screenshot, enlarged">
    <button class="lb-close" type="button" aria-label="Close">&times;</button>
    <img alt="" />
  </dialog>

  <script>
    const lb = document.querySelector<HTMLDialogElement>('dialog.lb')
    if (lb && typeof lb.showModal === 'function') {
      const big = lb.querySelector('img')!
      let opener: HTMLElement | null = null
      // the widest `w` candidate Astro emitted for this image; the plain src when there is none
      const largest = (img: HTMLImageElement) => {
        let best = img.currentSrc || img.src
        let w = 0
        for (const c of img.srcset.split(',')) {
          const [url, size] = c.trim().split(/\s+/)
          const n = parseInt(size ?? '', 10)
          if (url && n > w) (w = n), (best = url)
        }
        return best
      }
      for (const b of document.querySelectorAll<HTMLButtonElement>('.pf-zoom')) {
        b.addEventListener('click', () => {
          const img = b.querySelector('img')
          if (!img) return
          opener = b
          big.src = largest(img)
          big.alt = img.alt
          lb.showModal()
        })
      }
      const close = () => lb.open && lb.close()
      lb.querySelector('.lb-close')!.addEventListener('click', close)
      // a click on the backdrop lands on the dialog itself, never on the image or the button
      lb.addEventListener('click', (e) => e.target === lb && close())
      lb.addEventListener('close', () => {
        big.removeAttribute('src')
        opener?.focus()
        opener = null
      })
    }
  </script>

  <script>
    // Load three.js only when the hero can use it; the poster covers everyone else.
    const canvas = document.querySelector<HTMLCanvasElement>('.hero .orbit')
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    const weak = (navigator.hardwareConcurrency ?? 8) <= 4 || conn?.saveData
    if (canvas && !reduce && !weak) {
      const start = async () => {
        const { createOrbitScene } = await import('../scripts/orbit-scene.ts')
        let scene
        try {
          scene = createOrbitScene(canvas)
        } catch {
          return
        }
        const fit = () => scene.resize(canvas.clientWidth, canvas.clientHeight)
        fit()
        addEventListener('resize', fit)
        addEventListener('pointermove', (e) => scene.pointer(e.clientX / innerWidth - 0.5, e.clientY / innerHeight - 0.5))
        // ?frame=<seconds> draws that one moment and stops: posters, captures and video renders
        const still = new URLSearchParams(location.search).get('frame')
        if (still !== null) {
          scene.render(Number(still) || 40)
          document.documentElement.classList.add('orbit-live')
          return
        }
        let visible = true
        new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas)
        const t0 = performance.now()
        const loop = (now: number) => {
          if (visible && !document.hidden) scene.render((now - t0) / 1000 + 40)
          requestAnimationFrame(loop)
        }
        requestAnimationFrame((now) => {
          loop(now)
          document.documentElement.classList.add('orbit-live')
        })
      }
      if ('requestIdleCallback' in window) requestIdleCallback(() => start(), { timeout: 1200 })
      else setTimeout(start, 300)
    }
  </script>
</Site>
