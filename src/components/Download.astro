---
/**
 * The download call to action. It renders only when src/lib/release.mjs has a real url; until then
 * the page keeps the call to action it had, so a half-finished release cannot put a dead primary
 * button on the home page.
 *
 * Everything shown here — version, size, requirement, checksum — comes from that one module, so
 * the home page and the pricing page can never quietly disagree about what the current release is.
 *
 * The Mac download is still the gate: it is the build that is signed, notarised and tested, and
 * the Windows installer is offered beside it, labelled early, only when release.mjs has a real
 * file for it. A Windows visitor is told what "early" means before they download, not after.
 */
import {
  RELEASE,
  WINDOWS,
  ready,
  requirement,
  size,
  windowsReady,
  windowsRequirement,
  windowsSize,
} from '../lib/release.mjs'

interface Props {
  /** shown beside the download; the home page and the pricing page want different second buttons */
  secondary?: { href: string; label: string }
  compact?: boolean
}
const { secondary, compact = false } = Astro.props
---

{
  ready && (
    <>
      <div class:list={['hero-cta', compact && 'dl-compact']}>
        <a class="btn btn-light" href={`/download/${RELEASE.file}`} data-download={RELEASE.file}>Download for Mac</a>
        {windowsReady && (
          <a class="btn btn-ghost" href={`/download/${WINDOWS.file}`} data-download={WINDOWS.file}>
            Windows (early)
          </a>
        )}
        {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
      </div>
      <p class="dl-meta">
        Free and open source, MIT. Version {RELEASE.version} · {size} · {requirement}.
        <br />
        {RELEASE.signed ? (
          'Signed and notarised, so it opens without a warning.'
        ) : (
          <>
            This build is not signed yet, so macOS will block it the first time: right-click the app
            and choose Open, then Open again. <a href="#dl-why">Why</a>
          </>
        )}
      </p>
      {windowsReady && (
        <p class="dl-win">
          Windows {WINDOWS.version} · {windowsSize} · {windowsRequirement}. An early build, and not
          signed. <a href="#dl-win-why">What that means</a>
        </p>
      )}
      <details class="dl-sum" id="dl-why">
        <summary>{RELEASE.signed ? 'Checksum' : 'Checksum, and why macOS blocks it'}</summary>
        {!RELEASE.signed && (
          <p>
            This build carries no Developer ID signature, so macOS cannot check that it came from
            us and will refuse it until you open it by hand. That is exactly what the checksum
            below is for: it is how you confirm the file you have is the file we published.
          </p>
        )}
        <p>Verify the file you downloaded matches the one we published:</p>
        <code>shasum -a 256 {RELEASE.file}</code>
        <code class="dl-hash">{RELEASE.sha256}</code>
        {RELEASE.page && (
          <p>
            Release notes and the other builds are on <a href={RELEASE.page}>the release page</a>.
          </p>
        )}
      </details>

      {windowsReady && (
        <details class="dl-sum" id="dl-win-why">
          <summary>The Windows build: what works, and what Windows will say</summary>
          <p>
            It carries no code signature — there is no Windows certificate yet — so SmartScreen
            stops it the first time with “Windows protected your PC”: choose More info, then Run
            anyway. The checksum below is how you confirm the file you have is the file we
            published, and it is what stands in for a signature until there is one.
          </p>
          <p>
            It installs for you alone, needs no administrator, and lets you choose the folder. Two
            gaps worth knowing before you rely on it: secrets are not kept in a keychain on
            Windows, so anything that needs a stored credential is not safe there yet, and only the
            64-bit x64 build exists — an ARM PC is not served.
          </p>
          <p>Verify the file you downloaded matches the one we published, in PowerShell:</p>
          <code>certutil -hashfile "{WINDOWS.file}" SHA256</code>
          <code class="dl-hash">{WINDOWS.sha256}</code>
        </details>
      )}

      {/* The button goes through /download/<file>, which counts one "download started" at the pulse
          worker on the server and then redirects to GitHub (src/lib/download-hit.mjs): the count the
          Users panel reads, silent only for a visitor who asked not to be tracked. On top of that,
          src/lib/analytics-client.mjs watches [data-download] on every page and sends a `download`
          event to Vercel Web Analytics carrying the asset name in this attribute and nothing else.
          Neither is the real download count — GitHub has that, and `npm run check:downloads` reads it. */}
    </>
  )
}
