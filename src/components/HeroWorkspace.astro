              <li><time>13:30</time><i style="--c:#3ddc97"></i><span>Focus block</span><em>in 3h 6m</em></li>
              <li><time>15:00</time><i style="--c:#5b9dff"></i><span>Release planning</span><em>in 4h 36m</em></li>
            </ul>
          </section>

          <section class="w">
            <div class="wh">
              <span class="grip"></span>
              <svg viewBox="0 0 16 16"><path d="M2.5 9.5 4.3 3.8a1 1 0 0 1 1-.8h5.4a1 1 0 0 1 1 .8l1.8 5.7v3a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1z"></path><path d="M2.5 9.5h3.2l.8 1.5h3l.8-1.5h3.2"></path></svg>
              <span class="wt">Needs you</span><span class="wc">3</span><span class="wm">agents</span>
            </div>
            <ul class="hw-inbox">
              <li>
                <i></i>
                <div><b>atlas-api</b><span>Pick a passkey fallback</span></div>
                <em>2m</em>
              </li>
              <li>
                <i class="warn"></i>
                <div><b>infra-terraform</b><span>Approve <code>terraform apply</code></span></div>
