          <svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M9.4 1.1l.3 1.6c.4.1.8.3 1.1.5l1.4-.9 1.5 1.5-.9 1.4c.2.3.4.7.5 1.1l1.6.3v2.2l-1.6.3c-.1.4-.3.8-.5 1.1l.9 1.4-1.5 1.5-1.4-.9c-.3.2-.7.4-1.1.5l-.3 1.6H7.2l-.3-1.6c-.4-.1-.8-.3-1.1-.5l-1.4.9-1.5-1.5.9-1.4c-.2-.3-.4-.7-.5-1.1l-1.6-.3V6.9l1.6-.3c.1-.4.3-.8.5-1.1l-.9-1.4 1.5-1.5 1.4.9c.3-.2.7-.4 1.1-.5l.3-1.6h2.2zM8.3 5.6a2.4 2.4 0 100 4.8 2.4 2.4 0 000-4.8z"></path></svg>
