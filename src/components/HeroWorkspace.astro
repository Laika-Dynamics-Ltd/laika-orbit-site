---
/**
 * HeroWorkspace — a faithful HTML/CSS/SVG replica of the Laika Orbit app window for the hero.
 * Drawn on a fixed 1200×750 canvas and scaled to the container width (container query units),
 * so it stays crisp at any size. The map is generated here at build time; no client JS.
 */
const cx = 214
const cy = 346
const rad = (d: number) => (d * Math.PI) / 180
const pt = (r: number, a: number): [number, number] => [cx + r * Math.cos(rad(a)), cy + r * Math.sin(rad(a))]
const f = (n: number) => Math.round(n * 10) / 10

function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}
const R = rng(11)

type Group = { label: string; count: number; color: string; from: number; to: number; reach: number; lanes: number }
const groups: Group[] = [
  { label: 'REPOS', count: 18, color: '#ff9e78', from: 206, to: 250, reach: 62, lanes: 2 },
  { label: 'MAIL', count: 27, color: '#5b9dff', from: 258, to: 282, reach: 44, lanes: 1 },
  { label: 'CHATS', count: 9, color: '#c792ea', from: 290, to: 334, reach: 58, lanes: 2 },
  { label: 'NOTES', count: 64, color: '#ffc94f', from: 342, to: 398, reach: 52, lanes: 1 },
  { label: 'DOCUMENTS', count: 412, color: '#56d8ff', from: 48, to: 134, reach: 84, lanes: 2 },
  { label: 'WORKSPACE', count: 96, color: '#3ddc97', from: 142, to: 198, reach: 66, lanes: 2 },
]

const arms = groups.map((g) => {
  const n = Math.max(3, Math.round((g.to - g.from) / 6.2) + 1)
  const step = (g.to - g.from) / (n - 1)
  const buckets = ['', '', '']
  const heads: [number, number][] = []
  for (let i = 0; i < n; i++) {
    const a = g.from + i * step
    const len = g.reach * (0.45 + R() * 0.55)
    heads.push(pt(64, a))
    for (let d = 74; d < 74 + len; d += 4.4) {
      const t = (d - 74) / len
      for (let k = 0; k < g.lanes; k++) {
        if (R() < t * 0.55) continue
        const lat = (k - (g.lanes - 1) / 2) * 3.6 + (R() - 0.5) * 1.2
        const [x, y] = pt(d, a)
        const px = x - Math.sin(rad(a)) * lat
        const py = y + Math.cos(rad(a)) * lat
        const b = t < 0.3 ? 0 : t < 0.7 ? 1 : 2
        buckets[b] += `M${f(px)} ${f(py)}h0`
      }
    }
  }
  return { ...g, buckets, heads }
})

const arc = (r: number, a1: number, a2: number) => {
  const [x1, y1] = pt(r, a1)
  const [x2, y2] = pt(r, a2)
  return `M${f(x1)} ${f(y1)}A${r} ${r} 0 ${a2 - a1 > 180 ? 1 : 0} 1 ${f(x2)} ${f(y2)}`
}
const activity = [
  { d: arc(176, 150, 214), c: '#ff6b7a', o: 0.8 },
  { d: arc(176, 216, 236), c: '#ff7a45', o: 0.9 },
  { d: arc(176, 296, 322), c: '#c792ea', o: 0.55 },
  { d: arc(176, 20, 52), c: '#ffc94f', o: 0.45 },
]
const ticks = Array.from({ length: 72 }, (_, i) => {
  const a = i * 5
  const [x1, y1] = pt(190, a)
  const [x2, y2] = pt(i % 6 === 0 ? 196 : 193, a)
  return `M${f(x1)} ${f(y1)}L${f(x2)} ${f(y2)}`
}).join('')

const hi = pt(118, 76) // highlighted document node
const hexAt = (r: number, a: number) => {
  const [x, y] = pt(r, a)
  return Array.from({ length: 6 }, (_, i) => pt(0, 0) && [x + 9 * Math.cos(rad(60 * i - 90)), y + 9 * Math.sin(rad(60 * i - 90))])
    .map(([hx, hy], i) => `${i ? 'L' : 'M'}${f(hx)} ${f(hy)}`)
    .join('') + 'Z'
}
const badges = [
  { code: 'GH', name: 'GitHub', a: 250, r: 228 },
  { code: 'CA', name: 'Calendar', a: 289, r: 228 },
  { code: 'DR', name: 'Drive', a: 122, r: 232 },
].map((b) => ({ ...b, d: hexAt(b.r, b.a), p: pt(b.r, b.a) }))

const sessions = [
  { a: 228, label: 'pocket-app · 9m', lx: -8, ly: -9, anchor: 'end' },
  { a: 318, label: 'atlas-api · 2m', lx: -13, ly: -7, anchor: 'end' },
].map((s) => ({ ...s, p: pt(176, s.a) }))

const stars = [0, 90, 180, 270].map((a) => pt(40, a + 45))
---

