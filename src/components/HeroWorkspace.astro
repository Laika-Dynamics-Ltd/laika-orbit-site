    margin: 0 -6px;
    padding: 0 6px;
    font-size: 11px;
    border-radius: 5px;
  }
  .rt time {
    font: 500 10px var(--mono);
    color: var(--n25);
  }
  .rt span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rt small {
    font-size: 7.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--n23);
  }
  .rt em {
    font: normal 700 8px var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--n24);
  }
  .rt em.ok {
    color: var(--ok);
  }
  .rt em.acc {
    color: var(--acc);
  }
  .rt .nx {
    background: rgba(255, 122, 69, 0.08);
    box-shadow: inset 2px 0 0 var(--acc);
  }

  .brain {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }
  .brain b {
    font: 500 26px/1 var(--mono);
    color: var(--acc);
    letter-spacing: -0.02em;
  }
  .brain span {
    font-size: 8px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--n24);
  }
  .brain em {
    margin-left: auto;
    font: normal 500 10px var(--mono);
    color: var(--n25);
  }
  .bars {
    display: flex;
    gap: 2px;
    height: 4px;
    margin-top: 9px;
  }
  .bars u {
    display: block;
    border-radius: 2px;
    opacity: 0.85;
  }

  /* ---------------- map ---------------- */
  .stage {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 54% 49%, rgba(40, 52, 84, 0.22), transparent 70%),
      var(--n1);
  }
  .map {
    position: absolute;
    top: 0;
    left: 0;
    width: 470px;
    height: 706px;
  }
  .r-far {
    fill: none;
    stroke: var(--n14);
    stroke-dasharray: 2 6;
  }
  .r-out {
    fill: none;
    stroke: var(--n13);
  }
  .r-ticks {
    stroke: var(--n19);
    stroke-width: 1;
  }
  .r-main {
    fill: none;
    stroke: var(--n20);
    stroke-width: 1.2;
  }
  .r-thin {
    fill: none;
    stroke: var(--n14);
  }
  .r-act {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
  }
  .r-in {
    fill: none;
    stroke: var(--n16);
    stroke-dasharray: 1.5 3;
  }
  .r-core {
    fill: none;
    stroke: rgba(255, 122, 69, 0.25);
    stroke-dasharray: 1 3.5;
  }
  .dots {
    fill: none;
    stroke-width: 2.3;
    stroke-linecap: round;
  }
  .head {
    stroke: var(--n1);
    stroke-width: 1.4;
  }
  .hw-link {
    fill: none;
    stroke: rgba(137, 228, 255, 0.35);
    stroke-width: 0.8;
  }
  .core {
    fill: #26140d;
    stroke: var(--acc);
    stroke-width: 1.2;
    filter: drop-shadow(0 0 8px rgba(255, 122, 69, 0.45));
  }
  .core-in {
    fill: none;
    stroke: rgba(255, 158, 120, 0.6);
    stroke-dasharray: 2 2;
  }
  .lbl {
    font: 600 8.5px var(--mono);
    letter-spacing: 0.16em;
  }
  .cnt {
    fill: var(--n25);
  }
  .core-l {
    fill: var(--acc);
    font-size: 9.5px;
  }
  .core-s {
    font: 600 9px var(--mono);
    fill: var(--n32);
  }
  .core-xs {
    font: 600 6.5px var(--sans);
    letter-spacing: 0.14em;
    fill: var(--n24);
  }
  .hex {
    fill: var(--n5);
    stroke: var(--n20);
  }
  .hex-t {
    font: 700 7px var(--mono);
    fill: var(--n30);
  }
  .hex-n {
    font: 500 8px var(--sans);
    fill: var(--n24);
  }
  .sess {
    font: 600 9px var(--mono);
    fill: var(--acc);
  }
  .hi-ring {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 1.4;
  }
  .hi-pulse {
    fill: rgba(86, 216, 255, 0.2);
    transform-box: fill-box;
    transform-origin: center;
    animation: hw-pulse 2.4s ease-out infinite;
  }
  .hi-line {
    fill: none;
    stroke: rgba(137, 228, 255, 0.7);
    stroke-width: 0.9;
  }
  .tip {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 7px 10px 8px;
    border: 1px solid rgba(86, 216, 255, 0.28);
    border-radius: 7px;
    background: rgba(11, 14, 22, 0.92);
    box-shadow: 0 10px 24px -10px #000;
    white-space: nowrap;
  }
  .tip b {
    font: 600 11.5px/1.3 var(--sans);
    color: var(--n35);
  }
  .tip span {
    font: 400 9.5px/1.45 var(--mono);
    color: var(--n27);
  }
  .tip span:nth-child(2) {
    color: #89e4ff;
  }
  .corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--n20);
  }
  .corner.tl {
    top: 10px;
    left: 10px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .corner.bl {
    bottom: 10px;
    left: 10px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .hud {
    position: absolute;
    bottom: 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font: 600 8.5px/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hud.l {
    left: 26px;
  }
  .hud.r {
    right: 14px;
    text-align: right;
  }
  .hud b {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--cyan);
    font-weight: 700;
  }
  .hud.r b {
    justify-content: flex-end;
  }
  .hud b i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan);
  }
  .hud span {
    color: var(--n23);
  }

  /* ---------------- Claude panel ---------------- */
  .ss {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--n2);
    border-left: 1px solid var(--n16);
    box-shadow: -20px 0 40px -20px rgba(0, 0, 0, 0.8);
  }
  .ss-bar {
    flex: none;
    height: 40px;
    display: flex;
    align-items: stretch;
    gap: 6px;
    padding: 0 8px 0 4px;
    border-bottom: 1px solid var(--n13);
    background: var(--n2);
  }
  .ws-tabs {
    flex: 1;
    display: flex;
    align-items: stretch;
    gap: 2px;
    min-width: 0;
  }
  .ws-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 10px;
    font-weight: 500;
    font-size: 12px;
    color: var(--n27);
    white-space: nowrap;
  }
  .ws-tab > i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--ws);
  }
  .ws-tab > i.proj {
    border-radius: 50%;
  }
  .ws-tab.on {
    color: var(--n35);
    background: color-mix(in srgb, var(--ws) 9%, transparent);
    font-weight: 600;
  }
  .ws-tab.on::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--ws);
  }
  .ws-tab small {
    padding: 0 5px;
    border-radius: 999px;
    background: var(--n12);
    font-size: 10px;
    color: var(--n27);
  }
  .ws-tab.need::before {
    content: '';
    position: absolute;
    top: 9px;
    right: 3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--acc);
    box-shadow: 0 0 6px var(--acc);
  }
  .ws-plus {
    display: grid;
    place-items: center;
    padding: 0 6px;
    color: var(--n24);
    font-size: 15px;
  }
  .seg {
    align-self: center;
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--n14);
    border-radius: 7px;
  }
  .seg span {
    height: 22px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 6px;
    border-radius: 5px;
    color: var(--n25);
  }
  .seg span.on {
    background: var(--n9);
    color: #8ebbff;
  }
  .seg b {
    font: 600 10.5px var(--mono);
    color: var(--acc);
  }
  .seg svg,
  .bar-ic svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bar-ic {
    align-self: center;
    display: grid;
    place-items: center;
    width: 24px;
    color: var(--n25);
    font: 600 11px var(--mono);
  }
  .cols {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding-bottom: 9px;
  }
  .col + .col {
    border-left: 1px solid var(--n13);
  }
  .col.tint {
    background: linear-gradient(180deg, rgba(61, 220, 151, 0.035), rgba(61, 220, 151, 0.015));
    box-shadow: inset 0 2px 0 rgba(61, 220, 151, 0.4);
  }
  .ctabs {
    flex: none;
    height: 36px;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 0 8px;
    border-bottom: 1px solid var(--n12);
  }
  .ctab {
    height: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 7px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 11.5px;
    color: var(--n25);
    white-space: nowrap;
  }
  .ctab.on {
    color: var(--n34);
    border-color: var(--n16);
    background: var(--n7);
    box-shadow: inset 0 -2px 0 #5b9dff;
  }
  .ctab.turn {
    border-color: rgba(255, 122, 69, 0.35);
    box-shadow: inset 0 -2px 0 var(--acc);
  }
  .ctab i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.3px solid var(--n24);
  }
  .ctab i.run {
    border-color: var(--cyan);
    border-top-color: transparent;
    animation: hw-spin 1s linear infinite;
  }
  .ctab i.need {
    border: 0;
    background: var(--acc);
    box-shadow: 0 0 6px var(--acc);
  }
  .ctab em {
    font: normal 600 8.5px/13px var(--sans);
    width: 13px;
    text-align: center;
    border-radius: 50%;
    background: #213450;
    color: #8ebbff;
  }
  .ctab s {
    text-decoration: none;
    color: var(--n24);
  }
  .c-plus {
    padding: 0 6px;
    color: var(--n24);
    font-size: 14px;
  }
  .stream {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 12px 12px 8px 14px;
    overflow: hidden;
  }
  .you {
    padding: 8px 10px;
    border: 1px solid var(--n14);
    border-radius: 8px;
    background: var(--n6);
    font-size: 12px;
    line-height: 1.5;
    color: var(--n35);
  }
  .you code,
  .say code {
    font-size: 10.5px;
    color: var(--acc-lt);
  }
  .step {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font-size: 12px;
    white-space: nowrap;
    min-width: 0;
  }
  .step i {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    transform: translateY(-1px);
  }
  .step b {
    font-weight: 600;
    color: var(--n35);
  }
  .step span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--n27);
    font-family: var(--mono);
    font-size: 10.5px;
  }
  .step em {
    margin-left: auto;
    font: normal 500 10px var(--mono);
    color: var(--n24);
  }
  .hw ins {
    text-decoration: none;
    color: var(--ok);
  }
  .hw del {
    text-decoration: none;
    color: var(--err);
  }
  .diff,
  .io {
    margin-left: 13px;
    border: 1px solid var(--n16);
    border-radius: 6px;
    overflow: hidden;
    background: var(--n1);
    font: 400 10px/1.65 var(--mono);
  }
  .dl {
    display: grid;
    grid-template-columns: 22px 1fr;
    white-space: nowrap;
  }
  .dl i {
    font-style: normal;
    text-align: center;
    color: var(--n23);
  }
  .dl code {
    overflow: hidden;
    color: var(--n30);
  }
  .dl u {
    text-decoration: none;
    color: #8ebbff;
  }
  .dl.add {
    background: rgba(61, 220, 151, 0.09);
  }
  .dl.add i {
    color: var(--ok);
  }
  .dl.del {
    background: rgba(255, 107, 122, 0.09);
  }
  .dl.del i {
    color: var(--err);
  }
  .io > div {
    display: grid;
    grid-template-columns: 34px 1fr;
    padding: 3px 0;
  }
  .io > div.out {
    border-top: 1px solid var(--n14);
    background: rgba(86, 216, 255, 0.03);
  }
  .io i {
    font-style: normal;
    font-weight: 600;
    font-size: 8.5px;
    text-align: center;
    color: var(--n24);
  }
  .io code {
    color: var(--n32);
  }
  .io code span {
    color: var(--n24);
  }
  .say {
    padding-left: 13px;
    font-size: 12px;
    line-height: 1.55;
    color: var(--n34);
  }
  .computing {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 1px;
    font-size: 11.5px;
    white-space: nowrap;
  }
  .computing b {
    font-weight: 500;
    color: var(--acc);
  }
  .computing span {
    color: var(--n25);
    font-size: 11px;
  }
  .computing .spark {
    color: var(--acc);
    font-size: 11px;
    animation: hw-spin 3s linear infinite;
    display: inline-block;
  }
  .caret {
    width: 6px;
    height: 12px;
    background: var(--acc);
    border-radius: 1px;
    animation: hw-blink 1.1s steps(1) infinite;
  }
  .tasks {
    flex: none;
    margin: 0 10px;
    border: 1px solid var(--n16);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    background: var(--n4);
  }
  .tk-h {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding: 5px 10px 4px;
    font-size: 11px;
    color: var(--n27);
    white-space: nowrap;
    overflow: hidden;
  }
  .tk-h > span {
    font-size: 8px;
    color: var(--n24);
  }
  .tk-h b {
    color: var(--n34);
    font-weight: 600;
  }
  .tk-h em {
    font-style: normal;
    color: var(--n24);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tasks ol {
    display: grid;
    gap: 2px;
    padding: 0 10px 8px 22px;
  }
  .tasks li {
    display: grid;
    grid-template-columns: 10px 1fr;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .tasks li i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.4px solid var(--n24);
  }
  .tasks li.completed {
    color: var(--n24);
    text-decoration: line-through;
    text-decoration-color: var(--n23);
  }
  .tasks li.completed i {
    background: var(--ok);
    border-color: var(--ok);
  }
  .tasks li.in_progress {
    color: var(--n35);
  }
  .tasks li.in_progress i {
    border-color: var(--cyan);
    border-top-color: transparent;
    animation: hw-spin 1s linear infinite;
  }
  .tasks li.pending {
    color: var(--n27);
  }
  .cx {
    flex: none;
    margin: 0 10px;
    border: 1px solid var(--n16);
    border-radius: 9px;
    background: var(--n5);
  }
  .cx.attached {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .cx-in {
    padding: 9px 11px 12px;
    font-size: 12px;
    color: var(--n24);
  }
  .cx-row {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 6px 6px;
  }
  .chip {
    height: 22px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 5px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 10.5px;
    color: var(--n27);
    white-space: nowrap;
  }
  .chip i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .chip small {
    font-size: 7px;
    color: var(--n23);
  }
  .chip.plain {
    font-family: var(--mono);
    padding: 0 4px;
  }
  .chip.box {
    border-color: var(--n16);
  }
  .stop,
  .send {
    margin-left: auto;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 6px;
  }
  .stop {
    background: #3a1318;
  }
  .stop u {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: #ff8f9b;
  }
  .send {
    background: rgba(61, 220, 151, 0.14);
    color: var(--ok);
    font-size: 12px;
    font-weight: 700;
  }
  .sugg {
    flex: none;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 10px 6px;
    padding: 6px 10px;
    border: 1px dashed var(--n16);
    border-radius: 8px;
    font-size: 11px;
    white-space: nowrap;
  }
  .sugg span {
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--n24);
  }
  .sugg b {
    font-weight: 500;
    color: var(--n32);
  }
  .sugg i {
    margin-left: auto;
    font-style: normal;
    color: var(--n24);
  }
  .ask {
    margin: 2px 0 0 13px;
    border: 1px solid #3b2d20;
    border-radius: 8px;
    background: #13110f;
    overflow: hidden;
    box-shadow: 0 0 0 3px rgba(255, 122, 69, 0.04);
  }
  .ask-k {
    padding: 8px 11px 0;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--acc);
  }
  .ask-k span {
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--n24);
    font-size: 10px;
  }
  .ask-h {
    padding: 3px 11px 6px;
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--n35);
  }
  .opts {
    display: flex;
    flex-direction: column;
    padding: 0 5px 6px;
  }
  .opt {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 5px 7px;
    border-radius: 6px;
    font-size: 11.5px;
  }
  .opt.on {
    background: #261b12;
  }
  .opt kbd {
    flex: none;
    min-width: 17px;
    padding: 0 4px;
    border: 1px solid var(--n16);
    border-bottom-width: 2px;
    border-radius: 4px;
    font-size: 10px;
    line-height: 15px;
    text-align: center;
    color: var(--n27);
    background: var(--n6);
  }
  .opt.on kbd {
    border-color: var(--acc);
    color: var(--acc);
  }
  .opt b {
    display: block;
    font-weight: 600;
    color: var(--n34);
  }
  .opt em {
    display: block;
    font-style: normal;
    font-size: 10.5px;
    line-height: 1.4;
    color: var(--n25);
  }
  .ask-f {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 11px 10px;
  }
  .go {
    padding: 3px 12px;
    border-radius: 6px;
    background: var(--acc);
    color: var(--acc-ink);
    font-weight: 650;
    font-size: 11.5px;
  }
  .skip {
    padding: 3px 8px;
    color: var(--n27);
    font-size: 11.5px;
  }
  .hint {
