---
// The site's own brand mark and a link row back to the main site, in place of Starlight's text title.
---

<div class="docs-brand">
  <a class="docs-home" href="/" aria-label="Laika Orbit home">
    <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><ellipse cx="16" cy="16" rx="13" ry="5.5" fill="none" stroke="currentColor" stroke-width="1.8" transform="rotate(-28 16 16)"></ellipse><circle cx="16" cy="16" r="4.2" fill="var(--sl-color-accent)"></circle></svg>
    <span>Laika Orbit</span>
  </a>
  <span class="docs-badge">Docs</span>
  <nav class="docs-links" aria-label="Site">
    <a href="/#product">Product</a>
    <a href="/pricing/">Pricing</a>
  </nav>
</div>

<style>
  .docs-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .docs-home {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--sl-color-white);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }
  .docs-badge {
    font: 500 11px/1 var(--__sl-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    padding: 4px 7px;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 6px;
  }
  .docs-links {
    display: none;
    gap: 22px;
    margin-left: 18px;
    font-size: 14px;
  }
  .docs-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .docs-links a:hover {
    color: var(--sl-color-white);
  }
  @media (min-width: 72rem) {
    .docs-links {
      display: flex;
    }
  }
</style>
